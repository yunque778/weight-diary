.wrap {
  max-width: 640rpx;
  margin: 0 auto;
  padding: 16rpx 0 80rpx;
}
page {
  padding: 0 40rpx;
  box-sizing: border-box;
}

/* ---------- 头部 ---------- */
.kicker {
  font-size: 24rpx;
  letter-spacing: 0.14em;
  color: var(--ink-3);
  margin-top: 16rpx;
}
.title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
}
.h1 {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 0.02em;
}
.today {
  font-size: 26rpx;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.banner {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  background: var(--surface-2);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.5;
}

/* ---------- 录入 ---------- */
.entry {
  margin-top: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  box-shadow: var(--shadow);
  padding: 32rpx;
}
.seg {
  display: flex;
  gap: 12rpx;
  background: var(--surface-2);
  border-radius: 20rpx;
  padding: 8rpx;
}
.seg-btn {
  flex: 1;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-weight: 600;
  font-size: 30rpx;
  color: var(--ink-2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}
.seg-btn.on {
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex: none;
}
.dot-me { background: var(--me); }
.dot-cat { background: var(--cat); }

.field-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}
.field { margin-top: 20rpx; }
.field-row .field { margin-top: 0; }
.field:first-child { margin-top: 0; }
.label {
  font-size: 25rpx;
  color: var(--ink-2);
  margin-bottom: 8rpx;
}
.weight-input {
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--bg);
  padding: 12rpx 24rpx;
  font-size: 44rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  height: 76rpx;
  line-height: 76rpx;
  box-sizing: border-box;
}
.text-input {
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--bg);
  padding: 16rpx 24rpx;
  font-size: 29rpx;
  height: 72rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}
.picker-value {
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--bg);
  padding: 16rpx 24rpx;
  font-size: 29rpx;
  height: 72rpx;
  line-height: 72rpx;
  box-sizing: border-box;
  font-variant-numeric: tabular-nums;
}
.ph { color: var(--ink-3); }
.save-btn {
  margin-top: 24rpx;
  width: 100%;
  border-radius: 24rpx;
  background: var(--me);
  color: #fff;
  font-weight: 600;
  font-size: 32rpx;
  padding: 24rpx 0;
  letter-spacing: 0.06em;
}
.save-btn.cat-mode { background: var(--cat); }
.form-msg {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--bad);
}

/* ---------- 贴片 ---------- */
.tiles {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 32rpx;
}
.tile {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--shadow);
}
.who {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.val {
  font-size: 66rpx;
  font-weight: 600;
  line-height: 1.1;
  margin-top: 10rpx;
  font-variant-numeric: tabular-nums;
}
.unit {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink-2);
  margin-left: 6rpx;
}
.sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
  line-height: 1.45;
}
.chip {
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  margin-top: 16rpx;
}
.chip-good { background: var(--good-soft); color: var(--good); }
.chip-warn { background: var(--warn-soft); color: var(--warn); }
.chip-bad { background: var(--bad-soft); color: var(--bad); }
.chip-neutral { background: var(--surface-2); color: var(--ink-2); }
.no-data {
  font-size: 28rpx;
  color: var(--ink-3);
  margin-top: 16rpx;
}
.no-data.pad { padding: 24rpx 0; }

/* ---------- 图表 ---------- */
.chart-card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 32rpx 32rpx 20rpx;
  box-shadow: var(--shadow);
  margin-top: 32rpx;
}
.chart-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx 20rpx;
  margin-bottom: 12rpx;
}
.name {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-weight: 600;
  font-size: 30rpx;
}
.live {
  font-size: 26rpx;
  color: var(--ink-2);
  font-variant-numeric: tabular-nums;
  text-align: right;
}
.chart {
  width: 100%;
  height: 380rpx;
  display: block;
}
.chart-note {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}

/* ---------- 明细 ---------- */
.list-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 40rpx 0 8rpx;
}
.rec {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-variant-numeric: tabular-nums;
}
.rec:last-child { border-bottom: none; }
.rec .dot { width: 16rpx; height: 16rpx; }
.rec .date {
  font-size: 26rpx;
  color: var(--ink-2);
  width: 150rpx;
  flex: none;
}
.rec .who {
  font-size: 26rpx;
  color: var(--ink-3);
  width: 80rpx;
  flex: none;
}
.rec .w {
  font-size: 32rpx;
  font-weight: 600;
  min-width: 130rpx;
  flex: none;
}
.rec .delta {
  font-size: 25rpx;
  color: var(--ink-2);
  min-width: 90rpx;
  flex: none;
}
.rec .note {
  flex: 1;
  font-size: 25rpx;
  color: var(--ink-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}
.rec .del {
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  flex: none;
}
.rec .del.confirm {
  color: var(--bad);
  font-weight: 600;
  background: var(--bad-soft);
}

/* ---------- 设置 ---------- */
.settings-head {
  margin-top: 40rpx;
  font-weight: 600;
  font-size: 30rpx;
  padding: 24rpx 32rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.arrow {
  color: var(--ink-3);
  transition: transform 0.15s;
  font-size: 32rpx;
}
.arrow.rot { transform: rotate(90deg); }
.settings-body {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-top: none;
  border-radius: 0 0 24rpx 24rpx;
  padding: 8rpx 32rpx 32rpx;
}
.settings-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding-top: 20rpx;
}
.settings-grid .field { margin-top: 0; }
.ghost-btn {
  margin-top: 24rpx;
  border: 1rpx solid var(--line);
  background: var(--surface-2);
  border-radius: 20rpx;
  padding: 18rpx 32rpx;
  font-weight: 600;
  font-size: 28rpx;
  color: var(--ink);
}
.backup-row {
  display: flex;
  gap: 20rpx;
  margin-top: 0;
}
.backup-row .ghost-btn { flex: 1; margin-top: 20rpx; }
.backup-hint {
  font-size: 24rpx;
  color: var(--ink-3);
  margin-top: 20rpx;
  line-height: 1.6;
}

/* ---------- 页脚 ---------- */
.footer {
  margin-top: 52rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
}
